# Copy to .env and fill in:   cp .env.example .env
# Read by `docker compose` (fed into the containers) and by
# config/settings.py for local `make runserver`. Never commit .env.
#
# Keep values free of `$` - compose treats it as variable interpolation.

# ============================================================
# MANDATORY - compose refuses to start without these
# ============================================================

# Long random string. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Comma-separated hostnames/IPs the site answers to. On the server, add
# its public IP now, and the domain name once there is one, e.g.
#   DJANGO_ALLOWED_HOSTS=203.0.113.10,salinaspilots.org,www.salinaspilots.org
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Password for the compose Postgres service (set once, before the first
# `docker compose up` - changing it later doesn't change an existing
# database's password). Generate one the same way as the secret key.
POSTGRES_PASSWORD=

# ============================================================
# OPTIONAL - defaults shown; uncomment to change
# ============================================================

# --- Django ---
# Never on in a real deployment. (`make runserver` turns it on for
# itself regardless of this value.)
# DJANGO_DEBUG=false

# Turn on once nginx terminates TLS: secure cookies, HTTPS redirect, HSTS.
# Leave off while serving plain HTTP, or logging in won't work.
# DJANGO_HTTPS=false

# Only needed for cross-origin form posts; same-origin works without it.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://salinaspilots.org

# Times are stored in UTC and shown in each visitor's browser timezone;
# this is the fallback for a visitor whose zone isn't known yet.
# DJANGO_TIME_ZONE=America/Los_Angeles

# DJANGO_LOG_LEVEL=INFO

# --- Database ---
# Compose's web service always connects to its own `db` service; these
# name the database/user it creates and connects as.
# POSTGRES_DB=aviation
# POSTGRES_USER=aviation
#
# Outside compose, the site uses SQLite unless POSTGRES_HOST is set.
# POSTGRES_HOST=
# POSTGRES_PORT=5432

# --- Files ---
# Where db.sqlite3, media/ and private_media/ live. Compose sets this to
# /data itself; outside compose it defaults to the repo root.
# DATA_DIR=

# --- Serving ---
# gunicorn worker processes (~2 per CPU core is plenty for this site).
# GUNICORN_WORKERS=3

# Host port nginx listens on.
# HTTP_PORT=80
