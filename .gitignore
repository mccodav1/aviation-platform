# Python
__pycache__/
*.py[cod]
.venv/

# Editors / OS
.idea/
.DS_Store

# Secrets - copy .env.example instead
.env

# Local database (and any backups of it) and generated/uploaded media.
# Repopulate with `make bootstrap`.
db.sqlite3*
media/

# Private uploads (meeting agendas/minutes, Resource files) - never
# publicly served (see core/storage.py); per-deployment content like
# media/, not tracked.
private_media/

# collectstatic output - a build artifact regenerated from static/ on
# each deploy, not source and not runtime state.
staticfiles/

# Claude Code's local project settings/state - tooling config, not
# app source.
.claude/
